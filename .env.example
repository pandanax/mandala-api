# Скопируйте в `.env` и подставьте реальные значения. Секреты в репозиторий не коммитить.

# --- PostgreSQL (тикет 2: compose + приложение) ---
# Параметры ниже должны совпадать с URL в DATABASE_URL (user, password, db, порт).
POSTGRES_USER=mandala
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mandala
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mandala:changeme@localhost:5432/mandala
# Пул коннектов рассчитан на конкурентный путь ответа (ходы исполняются в worker-потоках,
# см. db/engine.py). Значения по умолчанию покрывают YC concurrency 16 с запасом.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# --- Telegram-бот (long polling + webhook в FastAPI) ---
# Одна вертикаль (обратная совместимость): токен + slug вертикали.
TELEGRAM_BOT_TOKEN=000000000:placeholder-token-from-botfather
# Slug вертикали из ``agent_verticals`` (после seed: astrology, therapy)
TELEGRAM_VERTICAL_ID=astrology
#
# Несколько ботов в одном процессе (мультитенант). Приоритет высший → низший:
#   1) TELEGRAM_BOT_TOKEN_<VERTICAL> — по env-переменной на вертикаль (<VERTICAL> в ВЕРХНЕМ
#      регистре = slug). Пример:
#        TELEGRAM_BOT_TOKEN_ASTROLOGY=111:aaa
#        TELEGRAM_BOT_TOKEN_THERAPY=222:bbb
#   2) TELEGRAM_BOT_TOKENS — JSON-объект {"<vertical>": "<token>", ...}. Пример:
#        TELEGRAM_BOT_TOKENS={"astrology":"111:aaa","therapy":"222:bbb"}
#   3) TELEGRAM_BOT_TOKEN + TELEGRAM_VERTICAL_ID (выше) — одна вертикаль.
# Webhook резолвит токен по {vertical_id} из пути; polling поллит все вертикали.
# TELEGRAM_BOT_TOKEN_ASTROLOGY=
# TELEGRAM_BOT_TOKENS=
# Username бота (без @) для deep-link кликабельных терминов t.me/<username>?start=<payload>.
# Если не задан — резолвится автоматически через getMe (кэшируется). Задайте, чтобы
# избежать лишнего вызова API. Пример: TELEGRAM_BOT_USERNAME=mandala_astro_bot
# TELEGRAM_BOT_USERNAME=
# Секретный токен для webhook: передаётся в setWebhook как secret_token; в продакшене задавайте обязательно (см. README).
TELEGRAM_WEBHOOK_SECRET=your-secret-webhook-token

# --- Пакетная монетизация: кошелёк сообщений + пакеты Telegram Stars ---
# Модель: у пользователя баланс сообщений (на users.message_balance); каждый LLM-ответ
# списывает 1; баланс не сгорает и не сбрасывается по времени (и переживает /reset).
# Новый пользователь получает стартовый разовый грант (по умолчанию 20 сообщений).
# MANDALA_MESSAGE_WALLET_START=20
#
# Три пакета (payload ↔ цена в ⭐ ↔ +сообщений) — единый источник message_packs.py.
# Цены и гранты параметризуемы (целые ≥ 1); дефолты: 1⭐→100, 2⭐→300, 5⭐→1000.
# MANDALA_PACK_100_PRICE=1
# MANDALA_PACK_100_MESSAGES=100
# MANDALA_PACK_300_PRICE=2
# MANDALA_PACK_300_MESSAGES=300
# MANDALA_PACK_1000_PRICE=5
# MANDALA_PACK_1000_MESSAGES=1000

# --- HTTP сервер (тикет 10: FastAPI) ---
# Порт для FastAPI приложения (по умолчанию 8000)
PORT=8000
# Хост для привязки (по умолчанию 0.0.0.0)
HOST=0.0.0.0

# --- LLM, OpenAI-совместимый HTTP API (тикет 11+) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-placeholder-replace-me
# Глобальный дефолт модели. Fallback для вертикалей БЕЗ явного per-vertical override.
LLM_MODEL=gpt-4o-mini
# Выбор модели вертикали — приоритет (высший → низший), см. docs/agent.md:
#   1. LLM_MODEL_<VERTICAL>          (явный env-override per-vertical; перебивает JSON)
#   2. vertical_overrides.json       (bundled в пакете или файл из LLM_VERTICAL_OVERRIDES_PATH)
#   3. LLM_MODEL                      (глобальный дефолт)
# Bundled JSON фиксирует astrology/therapy = deepseek-v4-flash. Чтобы сменить модель вертикали
# без правки JSON — задай LLM_MODEL_<VERTICAL> (например ниже). Effective-модель каждой
# вертикали печатается в лог при старте приложения (см. http/app.py lifespan).
# LLM_MODEL_ASTROLOGY=deepseek-v4-flash
# LLM_MODEL_THERAPY=deepseek-v4-flash
# Часовой пояс для строки «сейчас» в system-слое LLM (прогнозы на месяц и т.п.); IANA, по умолчанию Europe/Moscow.
# MANDALA_LLM_CONTEXT_TZ=Europe/Moscow
# Опционально: свой JSON с переопределениями per vertical_id (slug). Если не задан —
# подхватывается mandala/llm/vertical_overrides.json из пакета при наличии.
# LLM_VERTICAL_OVERRIDES_PATH=/absolute/path/to/overrides.json
# Эмбеддинги для RAG (тикет 16) — тот же LLM_BASE_URL / LLM_API_KEY:
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# RAG_VECTOR_SIZE=1536

# --- Генерация изображений (тикет 15): OpenAI-compatible POST …/images/generations ---
# stub — только заглушка без HTTP и без фото в Telegram; openai_compatible — реальный вызов (URL в ответе).
# IMAGE_BASE_URL / IMAGE_API_KEY можно не задавать — возьмутся LLM_BASE_URL и LLM_API_KEY.
# IMAGE_GENERATION_PROVIDER=stub
# IMAGE_GENERATION_PROVIDER=openai_compatible
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=sk-placeholder-replace-me
# IMAGE_MODEL=dall-e-3

# --- Голос → текст (STT): OpenAI-compatible POST …/audio/transcriptions (Whisper-совместимо) ---
# Голосовые/аудио сообщения Telegram скачиваются и транскрибируются, затем идут обычным
# текстовым пайплайном. Русский язык поддержан: по умолчанию STT_LANGUAGE=ru.
# STT_BASE_URL / STT_API_KEY можно не задавать — возьмутся LLM_BASE_URL и LLM_API_KEY,
# если тот же провайдер умеет /audio/transcriptions. Если URL+ключ не заданы — голос мягко
# деградирует (бот попросит написать текстом), приложение не падает.
# STT_PROVIDER=openai_compatible   # off|none — выключить; по умолчанию авто (вкл., если есть URL+ключ)
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=sk-placeholder-replace-me
# STT_MODEL=whisper-1
# STT_LANGUAGE=ru                  # пусто = автоопределение языка

# --- Анкета вертикали (тикет 13): шаги и промпты в JSON ---
# Опционально: свой JSON с цепочками per vertical_id. Если не задан —
# подхватывается mandala/verticals/intake_steps.json из пакета при наличии.
# MANDALA_INTAKE_STEPS_PATH=/absolute/path/to/intake_steps.json

# --- RAG / Qdrant (тикет 16; используется базой знаний «Карты судьбы») ---
# По умолчанию RAG выключен (none) → бот работает без базы знаний. Чтобы включить,
# нужны: (1) запущенный Qdrant, (2) MANDALA_RAG_BACKEND=qdrant + QDRANT_URL,
# (3) валидные LLM_* для эмбеддингов (см. выше LLM_EMBEDDING_MODEL / RAG_VECTOR_SIZE).
#
# ЛОКАЛЬНЫЙ dev-путь (полностью на своей машине):
#   1) podman compose up -d qdrant          # поднять Qdrant на localhost:6333
#   2) экспортировать в окружение:
#        MANDALA_RAG_BACKEND=qdrant
#        QDRANT_URL=http://localhost:6333
#        LLM_BASE_URL=... LLM_API_KEY=...   # эмбеддинги идут по этим же кредам
#        LLM_EMBEDDING_MODEL=text-embedding-3-small   # RAG_VECTOR_SIZE=1536 под модель
#   3) проиндексировать базу знаний вертикали:
#        python -m mandala.index_kb --vertical astrology --recreate-collection
#      (читает kb/astrology/**.md — включая kb/astrology/destiny_matrix/*).
#   После этого retrieval автоматически подмешивает KB в system-промпт (text_reply).
#
# PROD: нужен доступный экземпляр Qdrant (managed/собственный) + те же переменные
# (QDRANT_URL, при необходимости QDRANT_API_KEY) и эмбеддинг-модель. Индексацию
# запускать при выкладке KB. RAG_VECTOR_SIZE обязан совпадать с размерностью модели.
# MANDALA_RAG_BACKEND=none
# MANDALA_RAG_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# MANDALA_QDRANT_COLLECTION=mandala_kb
# MANDALA_KB_ROOT=
# RAG_TOP_K=5
# RAG_MAX_CONTEXT_CHARS=8000
# RAG_CHUNK_CHARS=1200
# RAG_CHUNK_OVERLAP=200
# QDRANT_PORT=6333
